@startuml
title Template Method - Funcionário

abstract class Funcionario {
    - matricula: int
    # nome: String
    - salarioBase: float
    - adicional: float
    + getMatricula(): int
    + setMatricula(matricula: int): void
    + getNome(): String
    + setNome(nome: String): void
    + getSalarioBase(): float
    + setSalarioBase(salarioBase: float): void
    + getAdicional(): float
    + setAdicional(adicional: float): void
    + calcularSalarioTotal(): float
    + {abstract} verificarBonus(): String
    + getTipo(): String
    + getInfo(): String
}

class FuncionarioOperacional {
    + verificarBonus(): String
}

class FuncionarioGerente {
    + verificarBonus(): String
    + getTipo(): String
}

Funcionario <|-- FuncionarioOperacional
Funcionario <|-- FuncionarioGerente

@enduml
